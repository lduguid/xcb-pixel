# Windows binaries.
#   make -f Makefile.win32                 MinGW-w64 (default)
#   make -f Makefile.win32 TOOLSET=msvc    Visual Studio cl (vcvars64)
#
# From WSL, MinGW uses the cross compiler. MSVC still runs Windows cl via cmd.

TOOLSET ?= mingw

.DEFAULT_GOAL := all
.PHONY: all clean check-mingw check-msvc

ifeq ($(TOOLSET),msvc)

ifeq ($(OS),Windows_NT)
CL = msvc-cl.cmd
else
CL = sh msvc-cl.sh
endif

all: check-msvc xcb-pixel.exe
	@echo "win32 TOOLSET=msvc  (cl)"

check-msvc:
	@$(CL) /nologo /? >/dev/null || { \
	  echo "Need Visual Studio C++ x64 toolset (cl + vcvars64)."; \
	  echo "  make -f Makefile.win32 TOOLSET=msvc"; \
	  echo "  Or set VCVARS to your vcvars64.bat"; \
	  exit 1; }

xcb-pixel.exe: demo.c fb.c plat_win32.c fb.h fb_internal.h
	$(CL) /nologo /O2 /W3 /D_CRT_SECURE_NO_WARNINGS /Fe:xcb-pixel.exe demo.c fb.c plat_win32.c \
		user32.lib gdi32.lib winmm.lib

else

ifeq ($(OS),Windows_NT)
MINGW_CC ?= gcc
else
MINGW_CC ?= x86_64-w64-mingw32-gcc
endif

all: check-mingw xcb-pixel.exe
	@echo "win32 TOOLSET=mingw  ($(MINGW_CC))"

check-mingw:
	@command -v $(MINGW_CC) >/dev/null || { \
	  echo "Need MinGW-w64. On Debian/Ubuntu/WSL:"; \
	  echo "  sudo apt install gcc-mingw-w64-x86-64"; \
	  echo "Then re-run: make -f Makefile.win32"; \
	  echo "Or: make -f Makefile.win32 TOOLSET=msvc"; \
	  exit 1; }

xcb-pixel.exe: demo.c fb.c plat_win32.c fb.h fb_internal.h
	$(MINGW_CC) -std=c11 -Wall -Wextra -O2 -o $@ demo.c fb.c plat_win32.c -lgdi32 -luser32 -lwinmm

endif

clean:
	rm -f xcb-pixel.exe *.obj
